@using X.PagedList
@model IPagedList<Order>

@{
    ViewBag.Title = "My Orders";
}

<div class="container my-4">
    <form data-ajax="true"
          data-ajax-update="#target"
          data-ajax-loading="#loader"
          id="f" class="d-flex gap-2 mb-3">
        @Html.Hidden("sort", "", new { form = "f" })
        @Html.Hidden("dir", "", new { form = "f" })

        <input type="search" name="search" id="search" value="@ViewBag.Search"
               class="form-control" style="max-width: 300px"
               placeholder="Search by Order Id" autofocus data-trim />
        <button class="btn btn-primary">Search</button>
        <img src="/photos/no-image.jpg" id="loader" style="display:none; width:24px;" />
    </form>

    <div id="target">
        <partial name="_HistoryList" model="Model" />
    </div>
</div>

@section foot {
    <script>
        let timer = null;
        $('#search').on('input', e => {
            clearTimeout(timer);
            timer = setTimeout(() => $(e.target.form).submit(), 500);
        });
    </script>
}
