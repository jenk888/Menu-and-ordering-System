@model ForgotPasswordVM
@{
    ViewBag.Title = "Forgot Password";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-header">
            <img src="/photos/icon/logo.png" class="auth-logo" alt="Yellow Palace" onerror="this.style.display='none'">
            <h2>Forgot Password</h2>
            <p>Enter your registered email address. We'll send you a link to reset your password.</p>
        </div>

        <form method="post" asp-action="ForgotPassword">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="mb-3">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" autofocus placeholder="you@gmail.com">
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button class="btn btn-primary w-100">Send Reset Link</button>
        </form>

        <p class="auth-footer"><a href="/User/Login">Back to Login</a></p>
    </div>
</div>