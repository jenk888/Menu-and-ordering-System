@model ResetPasswordVM
@{
    ViewBag.Title = "Reset Password";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-header">
            <img src="/photos/icon/logo.png" class="auth-logo" alt="Yellow Palace" onerror="this.style.display='none'">
            <h2>Reset Password</h2>
            <p>Choose a new password for your account</p>
        </div>

        <form method="post" asp-action="ResetPassword">
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="mb-3">
                <label asp-for="NewPassword"></label>
                <div class="input-group">
                    <input asp-for="NewPassword" class="form-control" id="newPwd" autofocus placeholder="New password">
                    <button class="btn btn-outline-secondary" type="button" onclick="togglePwd('newPwd', this)">Show</button>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword"></label>
                <div class="input-group">
                    <input asp-for="ConfirmPassword" class="form-control" id="confirmPwd" placeholder="Re-enter new password">
                    <button class="btn btn-outline-secondary" type="button" onclick="togglePwd('confirmPwd', this)">Show</button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button class="btn btn-primary w-100">Reset Password</button>
        </form>
    </div>
</div>

@section foot {
    <script>
        function togglePwd(id, btn) {
            var el = document.getElementById(id);
            if (el.type === "password") { el.type = "text"; btn.textContent = "Hide"; }
            else { el.type = "password"; btn.textContent = "Show"; }
        }
    </script>
}