@using X.PagedList
@model IPagedList<Category>
@{
    ViewBag.Title = "Category";
}

<div class="container my-4">
    <form id="batchDeleteForm" asp-action="BatchDelete" method="post"
          onsubmit="return confirm('Delete all selected categories?');"></form>

    <form id="f" method="get" asp-action="Index"
          data-ajax="true" data-ajax-update="#target" data-ajax-loading="#loader"
          class="d-flex align-items-center gap-2 mb-3" style="max-width: 500px">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control"
               placeholder="Search by name..." data-trim="" />
        <button type="submit" class="btn btn-outline-primary">Search</button>
        @if (!string.IsNullOrEmpty((string)ViewBag.Search))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        }
        <img src="/images/loader.gif" id="loader" style="display:none; width:24px; height:24px;" />
    </form>

    <div class="d-flex justify-content-between mb-3">
        <button type="submit" form="batchDeleteForm" class="btn btn-outline-danger">Delete Selected</button>
        <div class="d-flex gap-2">
            <a asp-action="BatchUpdate" class="btn btn-outline-primary">Batch Update</a>
            <a asp-action="BatchInsert" class="btn btn-outline-primary">Batch Insert</a>
            <a asp-action="Insert" class="btn btn-primary">Add Category</a>
        </div>
    </div>

    <div id="target">
        <partial name="_ManageCategoriesTable" model="Model" />
    </div>
</div>
