@model List<Category>
@{
    ViewBag.Title = "Category";
}

<div class="container my-4">
    <form id="batchDeleteForm" asp-action="BatchDelete" method="post"
          onsubmit="return confirm('Delete all selected categories?');"></form>

    <div class="d-flex justify-content-between mb-3">
        <button type="submit" form="batchDeleteForm" class="btn btn-outline-danger">Delete Selected</button>
        <div class="d-flex gap-2">
            <a asp-action="BatchUpdate" class="btn btn-outline-primary">Batch Update</a>
            <a asp-action="BatchInsert" class="btn btn-outline-primary">Batch Insert</a>
            <a asp-action="Insert" class="btn btn-primary">Add Category</a>
        </div>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Display Order</th>
                <th style="width: 160px;">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td><input type="checkbox" name="ids" value="@c.Id" form="batchDeleteForm" /></td>
                    <td>@c.Id</td>
                    <td>@c.Name</td>
                    <td>@c.DisplayOrder</td>
                    <td>
                        <a asp-action="Update" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">&#x270F;</a>
                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" style="display: inline" onsubmit="return confirm('Delete this category?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">&#x1F5D1;</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>