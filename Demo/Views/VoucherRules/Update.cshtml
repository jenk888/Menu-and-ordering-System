@model VoucherRuleUpdateViewModel
@{
    ViewBag.Title = "Update Voucher Rule";
}

<div class="container my-4" style="max-width: 500px">
    <h2>Update Voucher Rule</h2>
    <form asp-action="Update" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Rule Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MinimumSpend" class="form-label">Minimum Spend (RM)</label>
            <input asp-for="MinimumSpend" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="MinimumSpend" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DiscountAmount" class="form-label">Discount Amount (RM)</label>
            <input asp-for="DiscountAmount" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="DiscountAmount" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ExpiryDurationDays" class="form-label">Expiry Duration (Days)</label>
            <input asp-for="ExpiryDurationDays" class="form-control" type="number" />
            <span asp-validation-for="ExpiryDurationDays" class="text-danger"></span>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
            <label asp-for="IsActive" class="form-check-label">Is Active</label>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>