@model Demo.Models.User

@{
    ViewData["Title"] = "Member Details";
}

<div class="container d-flex justify-content-center align-items-center mt-5 mb-5">
    <div class="card shadow-sm p-4" style="width: 750px; border-radius: 15px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3>Profile Details</h3>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to List</a>
        </div>

        <div class="row align-items-center">

            <!-- Profile pic (Read-only) -->
            <div class="col-md-4 text-center border-end">
                <div class="mb-3">
                    <img src="/photos/@(Model.ProfilePhoto ?? "default.jpg")" class="rounded-circle shadow" style="width: 130px; height: 130px; object-fit: cover;" alt="Avatar" />
                </div>
                <span class="badge bg-success">Active</span>
            </div>

            <!-- member details (Read-only) -->
            <div class="col-md-8 ps-md-4">
                <div class="mb-3">
                    <label class="form-label fw-bold">Account ID:</label>
                    <input type="text" class="form-control-plaintext bg-light px-2 rounded" value="@Model.Id" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Name:</label>
                    <input type="text" class="form-control-plaintext bg-light px-2 rounded" value="@Model.Name" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Email:</label>
                    <input type="text" class="form-control-plaintext bg-light px-2 rounded" value="@Model.Email" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Phone:</label>
                    <input type="text" class="form-control-plaintext bg-light px-2 rounded" value="@Model.Phone" readonly />
                </div>
            </div>
        </div>

        <hr class="my-4" />

        <!-- reserve Voucher modal window  -->
        <div class="mb-3">
            <h5 class="fw-bold">Vouchers</h5>
            <p class="text-muted small">Voucher module integration pending...</p>
        </div>

        <hr class="my-4" />

        <!-- delete member (with Confirmatin msg) -->
        <div class="d-flex justify-content-end">
            <form asp-action="DeleteMember" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this member account? This action cannot be undone.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger px-4">Delete Account</button>
            </form>
        </div>
    </div>
</div>