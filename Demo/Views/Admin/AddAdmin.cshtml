@model AdminRegisterVm


@{
    ViewBag.Title = "Admin | Create Account";
}

<form class="form" method="post" enctype="multipart/form-data" data-ajax="false">
    <div asp-validation-summary="ModelOnly"></div>

    <label asp-for="Name"></label>
    <input asp-for="Name" autofocus>
    <span asp-validation-for="Name"></span>

    <label asp-for="Email"></label>
    <input asp-for="Email">
    <span asp-validation-for="Email"></span>

    <label asp-for="Phone"></label>
    <input asp-for="Phone">
    <span asp-validation-for="Phone"></span>

    <label asp-for="Password"></label>
    <input asp-for="Password">
    <span asp-validation-for="Password"></span>

    <label asp-for="ConfirmPassword"></label>
    <input asp-for="ConfirmPassword">
    <span asp-validation-for="ConfirmPassword"></span>

    <label asp-for="Photo"></label>
    <div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="choosePhotoBtn">Choose Photo</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="takePhotoBtn">Take Photo</button>
        </div>
        <input asp-for="Photo" id="Photo" type="file" accept="image/jpeg,image/png" hidden>
        <div id="photoPreviewList" class="d-flex flex-wrap gap-2 mt-2"></div>
    </div>
    <span asp-validation-for="Photo"></span>

    <section>
        <input type="submit" value="Register" class="btn btn-primary" />
        <input type="reset" value="Reset" class="btn btn-secondary" />
    </section>
</form>

@await Html.PartialAsync("_PhotoEditorModal")
@await Html.PartialAsync("_WebcamCaptureModal")

@section head {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
}

@section foot {
    <script src="/js/photoEditor.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>

    <script>
        $.validator.setDefaults({ ignore: '' });

        initPhotoEditor({
            fileInputId: "Photo",
            chooseButtonId: "choosePhotoBtn",
            previewListId: "photoPreviewList",
            webcamButtonId: "takePhotoBtn",
        });
    </script>
}