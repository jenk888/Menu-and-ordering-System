@model AdminRegisterVm

@{
    ViewBag.Title = "Admin | Create Account";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-header">
            <img src="/photos/icon/logo.png" class="auth-logo" alt="Yellow Palace" onerror="this.style.display='none'">
            <h2>Create Admin Account</h2>
            <p>Add a new administrator</p>
        </div>

        <form method="post" enctype="multipart/form-data" data-ajax="false">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="mb-3">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" autofocus placeholder="Admin's full name">
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="admin@gmail.com">
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone"></label>
                <input asp-for="Phone" class="form-control" placeholder="0123456789">
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password"></label>
                <div class="input-group">
                    <input asp-for="Password" class="form-control" id="adminPwd" placeholder="Password">
                    <button class="btn btn-outline-secondary" type="button" onclick="togglePwd('adminPwd', this)">Show</button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword"></label>
                <div class="input-group">
                    <input asp-for="ConfirmPassword" class="form-control" id="adminConfirmPwd" placeholder="Confirm password">
                    <button class="btn btn-outline-secondary" type="button" onclick="togglePwd('adminConfirmPwd', this)">Show</button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Photo"></label>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="choosePhotoBtn">Choose Photo</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="takePhotoBtn">Take Photo</button>
                </div>
                <input asp-for="Photo" id="Photo" type="file" accept="image/jpeg,image/png" hidden>
                <div id="photoPreviewList" class="d-flex flex-wrap gap-2 mt-2"></div>
                <span asp-validation-for="Photo" class="text-danger small"></span>
            </div>

            <button class="btn btn-primary w-100">Register</button>
        </form>

        <p class="auth-footer"><a href="/Admin/AdminList">Back to Admin List</a></p>
    </div>
</div>

@await Html.PartialAsync("_PhotoEditorModal")
@await Html.PartialAsync("_WebcamCaptureModal")

@section head {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
}

@section foot {
    <script src="/js/photoEditor.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>

    <script>
        $.validator.setDefaults({ ignore: '' });

        function togglePwd(id, btn) {
            var el = document.getElementById(id);
            if (el.type === "password") { el.type = "text"; btn.textContent = "Hide"; }
            else { el.type = "password"; btn.textContent = "Show"; }
        }

        initPhotoEditor({
            fileInputId: "Photo",
            chooseButtonId: "choosePhotoBtn",
            previewListId: "photoPreviewList",
            webcamButtonId: "takePhotoBtn",
        });
    </script>
}