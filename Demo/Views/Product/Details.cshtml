@model Product
@{
    ViewBag.Title = Model.Name;
}

@{
    var photoUrls = Model.Photos != null && Model.Photos.Any()
        ? Model.Photos.Select(p => "/photos/product/" + p.PhotoUrl).ToList()
        : new List<string> { "/photos/no-image.jpg" };
    var outOfStock = Model.Stock <= 0;
}

<div class="container my-4">
    <a asp-action="Index" class="btn btn-link ps-0 mb-3">&larr; Back to Products</a>
 
    <div class="row g-4">
        <div class="col-md-6">
            <div class="detail-photo-wrapper">
                <img id="main-photo" src="@photoUrls[0]" alt="@Model.Name" class="detail-photo">
            </div>

            @if (photoUrls.Count > 1)
            {
                <div class="detail-thumbs">
                    @for (int i = 0; i < photoUrls.Count; i++)
                    {
                        <img src="@photoUrls[i]" class="detail-thumb @(i == 0 ? "active" : "")" onclick="document.getElementById('main-photo').src=this.src; document.querySelectorAll('.detail-thumb').forEach(t=>t.classList.remove('active')); this.classList.add('active');">
                    }
                </div>
            }
        </div>

        <div class="col-md-6">
            <h2>@Model.Name</h2>

            @if (Model.Category != null)
            {
                <p class="text-muted mb-2">@Model.Category.Name</p>
            }

            <p class="detail-price mb-3">RM @(Model.Price.ToString("0.00"))</p>
            <p class="detail-stock mb-4">
                @if (outOfStock)
                {
                    <span class="text-danger">Out of Stock</span>
                }
                else
                {
                    <span>@Model.Stock in stock</span>
                }
            </p>
            
            <button class="btn btn-primary btn-lg" id="detailAddCartBtn" data-product-id="@Model.Id" @(outOfStock ? "disabled" : "")>
                @(outOfStock ? "Out of Stock" : "Add to Cart")
            </button>
        </div>
    </div>
</div>

@section foot {
    <script>
        document.getElementById("detailAddCartBtn")?.addEventListener("click", function() {
            const btn = this;
            if (btn.disabled) return;
            const productId = btn.getAttribute("data-product-id");
            btn.disabled = true;

            fetch('/Cart/Add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId: productId })
            })
                .then(async response => {
                    const data = await response.json().catch(() => null);
                    if (!response.ok) {
                        const message = data?.message || `Request failed (${response.status})`;
                        throw new Error(message);
                    }
                    return data;
                })
                .then(() => {
                    btn.textContent = "Added ✓";
                    setTimeout(() => {
                        btn.textContent = "Add to Cart";
                        btn.disabled = false;
                    }, 1200);
                })
                .catch(err => {
                    console.error("Error adding to cart:", err);
                    btn.disabled = false;
                    alert(err.message || "Could not add item to cart. Please try again.");
                });
        });
    </script>
}
