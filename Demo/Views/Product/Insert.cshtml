@model ProductInsertViewModel
@{
    ViewBag.Title = "Add Product";
}

<div class="container my-4" style="max-width: 500px">
    <form asp-action="Insert" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" class="form-select">
                <option value="">-- Select Category --</option>
                @foreach (var c in (List<Category>)ViewBag.Categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Name </label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">Price </label>
            <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Photos" class="form-label">Photos</label>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="choosePhotosBtn">Choose Photos</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="takePhotoBtn">Take Photo</button>
            </div>
            <input asp-for="Photos" type="file" accept="image/*" multiple class="form-control" style="display:none" />
            <div id="photoPreviewList" class="d-flex flex-wrap gap-2 mt-2"></div>
            <span asp-validation-for="Photos" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Manage" class="btn btn-secondary">Cancel</a>
    </form>

    @await Html.PartialAsync("_PhotoEditorModal")
    @await Html.PartialAsync("_WebcamCaptureModal")
</div>

@section head{
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
}

@section foot{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>   
    <script src="/js/photo-editor.js"></script>
    <script>
        initPhotoEditor({
            fileInputId: "Photos",
            chooseButtonId: "choosePhotosBtn",
            previewListId: "photoPreviewList",
            webcamButtonId: "takePhotoBtn",
        });
    </script>
}
