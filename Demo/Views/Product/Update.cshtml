@model ProductUpdateViewModel
@{
    ViewBag.Title = "Edit Product";
}


<div class="container my-4" style="max-width: 500px">
    <form asp-action="Update" method="post" enctype="multipart/form-data">
           <input type="hidden" asp-for="Id" />
           <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Name </label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">Price </label>
            <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        @if (Model.ExistingPhotos.Any())
         {
            <div class="mb-3">
                <label class="form-label">Current Photos<small class="text-muted">(tick to remove)</small></label>
                <div class="d-flex flex-wrap gap-3">
                    @for (int i = 0; i < Model.ExistingPhotos.Count; i++)
                    {
                    var photo = Model.ExistingPhotos[i];
                    <div class="text-center">
                        <img src="/photos/product/@photo.PhotoUrl" style="width:90px; height:90px; object-fit:cover; border-radius:6px" />
                        <input type="hidden" asp-for="ExistingPhotos[i].Id" />
                        <input type="hidden" asp-for="ExistingPhotos[i].PhotoUrl" />
                        <div class="form-check d-flex justify-content-center align-items-center mt-1 gap-1">
                            <input class="form-check-input" type="checkbox" name="DeletePhotoIds" value="@photo.Id" id="del-@photo.Id" />
                            <label class="form-check-label small" for="del-@photo.Id">Remove</label>
                        </div>
                    </div>
                    }
                </div>
                <span asp-validation-for="DeletePhotoIds" class="text-danger d-block mt-1"></span>
            </div>
        }

        <div class="mb-3">
            <label class="form-label">Add Photos</label>
            <div class="d-flex gap-2">
                <button type="button" id="choosePhotosBtn" class="btn btn-outline-secondary btn-sm">Choose Photos</button>
                <button type="button" id="takePhotoBtn" class="btn btn-outline-secondary btn-sm">Take Photo</button>
            </div>
            <input asp-for="NewPhotos" type="file" accept="image/*" multiple class="form-control" style="display:none" />
            <div id="photoPreviewList" class="d-flex flex-wrap gap-2 mt-2"></div>
            <span asp-validation-for="NewPhotos" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label mb-0">Modifier Groups</label>
                <a href="/Modifier/Create" class="btn btn-sm btn-outline-secondary">Create New Modifier Group</a>
            </div>

            @{ var modifierGroups = (List<ModifierGroup>)ViewBag.ModifierGroups; }
            @if (modifierGroups.Count == 0)
            {
                <div class="text-muted small">No modifier groups yet — create one first.</div>
            }
            else
            {
                <div class="border rounded p-2">
                    @foreach (var g in modifierGroups)
                    {
                        var isChecked = Model.ModifierGroupIds.Contains(g.Id);
                        <details class="mb-1">
                            <summary style="cursor:pointer;">
                                <input type="checkbox" name="ModifierGroupIds" value="@g.Id"
                                       checked="@isChecked" onclick="event.stopPropagation()" />
                                @g.Name
                                <span class="text-muted small">(@g.SelectionType, @(g.IsRequired ? "Required" : "Optional"))</span>
                            </summary>
                            <ul class="small text-muted mb-1 ms-4">
                                @foreach (var o in g.Options)
                                {
                                    <li>@o.Name @(o.ExtraPrice > 0 ? $"(+RM{o.ExtraPrice:0.00})" : "")</li>
                                }
                            </ul>
                        </details>
                    }
                </div>
            }
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Manage" class="btn btn-secondary">Cancel</a>

        </form>
     @await Html.PartialAsync("_PhotoEditorModal")
     @await Html.PartialAsync("_WebcamCaptureModal")
</div>

@section head{
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
}

@section foot{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>   
    <script src="/js/photoEditor.js"></script>
    <script>
        initPhotoEditor({
            fileInputId: "NewPhotos",
            chooseButtonId: "choosePhotosBtn",
            previewListId: "photoPreviewList",
            webcamButtonId: "takePhotoBtn",
        });
    </script>
}