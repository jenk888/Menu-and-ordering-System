@model ProductUpdateViewModel
@{
    ViewBag.Title = "Edit Product";
}

<div class="container my-4" style="max-width: 500px">
    <form asp-action="Update" method="post" enctype="multipart/form-data">
           <input type="hidden" asp-for="Id" />
           <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Name </label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">Price </label>
            <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        @if (!string.IsNullOrEmpty(Model.PhotoURL))
            {
                <div class="mb-3">
                    <label class="form-label">Current Photo</label> <br>
                    <img src="/photos/product/@Model.PhotoURL" style="width:120px; height:120px; object-fit:cover" />
                </div>
            }

        <div class="mb-3">
            <label asp-for="Photo" class="form-label">Replace Photo </label>
            <input asp-for="Photo" type="file" accept="image/*" class="form-control" />
            <span asp-validation-for="Photo" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Manage" class="btn btn-secondary">Cancel</a>

        </form>
</div>
