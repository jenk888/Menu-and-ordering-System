@model List<Product>
@{
    ViewBag.Title = "Manage Products";
}

<div class="container my-4">
    <form id="batchDeleteForm" asp-action="BatchDelete" method="post"
          onsubmit="return confirm('Delete all selected products?');"></form>
    
    
    <form method="get" asp-action="Manage" class="d-flex gap-2 mb-3" style="max-width: 550px">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or Id..." />
        <select name="categoryId" class="form-select" style="max-width: 200px" onchange="this.form.submit()">
            <option value="">All Categories</option>
            @foreach (var c in (List<Category>)ViewBag.Categories)
            {
                <option value="@c.Id" selected="@(ViewBag.CategoryId == c.Id)">@c.Name</option>
            }
        </select>
        <button type="submit" class="btn btn-outline-primary">Search</button>
        @if (!string.IsNullOrEmpty((string)ViewBag.Search) || ViewBag.CategoryId != null)
        {
            <a asp-action="Manage" class="btn btn-outline-secondary">Clear</a>
        }
    </form>

    <div class="d-flex justify-content-between mb-3">
        <button type="submit" form="batchDeleteForm" class="btn btn-outline-danger">Delete Selected</button>
        <div class="d-flex gap-2">
            <a asp-action="BatchUpdate" class="btn btn-outline-primary">Batch Update</a>
            <a asp-action="BatchInsert" class="btn btn-outline-primary">Batch Insert</a>
            <a asp-action="Insert" class="btn btn-primary">Add Product</a>
        </div>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th style="width: 30px">
                    <input type="checkbox" onclick="document.querySelectorAll('.rowCheck').forEach(c => c.checked = this.checked)" />
                </th>
                <th>Photo</th>
                <th>Id</th>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th style="width: 160px">Actions</th>
            </tr>
            </thead>

            <tbody>
                @foreach (var p in Model)
                {
                    var photoUrl = p.Photos.Select(ph => ph.PhotoUrl).FirstOrDefault();
                    <tr>
                        <td><input type="checkbox" class="rowCheck" name="ids" value="@p.Id" form="batchDeleteForm" /></td>
                        <td>
                            <img src="@(photoUrl != null?"/photos/products/"+ photoUrl :"/photos/no-image.jpg")" style="width:60px; height:60px; object-fit:cover;" />
                            @if (p.Photos.Count > 1)
                            {
                                <span class="badge bg-secondary" style="position:absolute; bottom:2px; left:2px;">+@(p.Photos.Count - 1)</span>
                            }
                        </td>
                        <td>@p.Id</td>
                        <td>@p.Name</td>
                        <td>@p.Category?.Name</td>
                        <td>RM@(p.Price.ToString("0.00"))</td>
                        <td>@p.Stock</td>
                        <td>
                            <a asp-action="ViewDetails" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            <a asp-action="Update" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" style="display: inline" onsubmit="return confirm('Delete this product?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
    </table>
</div>
