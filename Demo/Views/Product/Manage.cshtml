@model List<Product>
@{
    ViewBag.Title = "Manage Products";
}

<div class="container my-4">
    <!-- Search Bar -->
    @await Html.PartialAsync("_SearchBox", new ViewDataDictionary(ViewData)
    {
        {"SearchEvent", "product:search"},
        {"SearchPlaceholder", "Search products..."},
        {"SearchBoxId", "products"}
    })

    <!-- Category Filter Bar (Default "ALL") -->
    <div class="category-nav" id="categoryNav">
        <button class="category-btn active" data-category-id="ALL">All</button>
        @if (ViewBag.Categories != null)
        {
            foreach (var category in ViewBag.Categories)
            {
                <button class="category-btn" data-category-id="@category.Id">@category.Name</button>
            }
        }
    </div>

    <!-- AJAX Product Card Container -->
    <div class="product-grid" id="productContainer">
        <!-- Loaded dynamically via AJAX -->
    </div>
    <form id="batchDeleteForm" asp-action="BatchDelete" method="post"
          onsubmit="return confirm('Delete all selected products?');"></form>
    <div class="d-flex justify-content-between mb-3">
        <button type="submit" form="batchDeleteForm" class="btn btn-outline-danger">Delete Selected</button>
        <div class="d-flex gap-2">
            <a asp-action="BatchUpdate" class="btn btn-outline-primary">Batch Update</a>
            <a asp-action="BatchInsert" class="btn btn-outline-primary">Batch Insert</a>
            <a asp-action="Insert" class="btn btn-primary">Add Product</a>
        </div>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th></th>
                <th>Photo</th>
                <th>Id</th>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th style="width: 160px">Actions</th>
            </tr>
            </thead>

            <tbody>
                @foreach (var p in Model)
                {
                    var photoUrl = p.Photos.Select(ph => ph.PhotoUrl).FirstOrDefault();
                    <tr>
                        <td><input type="checkbox" name="ids" value="@p.Id" form="batchDeleteForm" /></td>
                        <td>
                            <img src="@(photoUrl != null?"/photos/product/"+ photoUrl :"/photos/no-image.jpg")" style="width:60px; height:60px; object-fit:cover;" />
                            @if (p.Photos.Count > 1)
                            {
                                <span class="badge bg-secondary" style="position:absolute; bottom:2px; left:2px;">+@(p.Photos.Count - 1)</span>
                            }
                        </td>
                        <td>@p.Id</td>
                        <td>@p.Name</td>
                        <td>@p.Category?.Name</td>
                        <td>RM@(p.Price.ToString("0.00"))</td>
                        <td>@p.Stock</td>
                        <td>
                            <a asp-action="Update" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">&#x270F;</a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" style="display: inline" onsubmit="return confirm('Delete this product?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">&#x1F5D1;</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
    </table>
</div>
