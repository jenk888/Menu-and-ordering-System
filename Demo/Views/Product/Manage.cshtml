@using X.PagedList
@model IPagedList<Product>
@{
    ViewBag.Title = "Manage Products";
}

<div class="container my-4">
    <form id="batchDeleteForm" asp-action="BatchDelete" method="post"
          onsubmit="return confirm('Delete all selected products?');">
    </form>
    <div class="d-flex justify-content-between mb-3">
        <button type="submit" form="batchDeleteForm" class="btn btn-outline-danger">Delete Selected</button>
        <div class="d-flex gap-2">
            <a asp-action="BatchUpdate" class="btn btn-outline-primary">Batch Update</a>
            <a asp-action="BatchInsert" class="btn btn-outline-primary">Batch Insert</a>
            <a asp-action="Insert" class="btn btn-primary">Add Product</a>
        </div>
    </div>

    @* Ajax form *@
    <form data-ajax="true" id="f" method="get" asp-action="Manage"
          data-ajax-update="#target" data-ajax-loading="#loader"
          class="d-flex align-items-center gap-2 mb-3" style="max-width: 700px">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control"
               placeholder="Search by name or Id..." data-trim="" />

        <select name="categoryId" class="form-select" style="max-width: 220px" onchange="this.form.submit()">
            <option value="">All Categories</option>
            @foreach (var c in (List<Category>)ViewBag.Categories)
            {
                <option value="@c.Id" selected="@(ViewBag.CategoryId == c.Id)">@c.Name</option>
            }
        </select>

        <button type="submit" class="btn btn-outline-primary">Search</button>
        @if (!string.IsNullOrEmpty((string)ViewBag.Search) || ViewBag.CategoryId != null)
        {
            <a asp-action="Manage" class="btn btn-outline-secondary">Clear</a>
        }
        <img src="/images/loader.gif" id="loader" style="display:none; width:24px; height:24px;" />
    </form>

    <div id="target">
        <partial name="_ManageProductsTable" model="Model" />
    </div>

</div>