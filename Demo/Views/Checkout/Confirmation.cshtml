@model Demo.Models.OrderConfirmationViewModel
@{
    ViewBag.Title = "Order Confirmation";
}


<style>
    .confirmation-wrapper {
        max-width: 640px;
        margin: 0 auto;
        text-align: center;
    }

    .confirmation-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background-color: #e6f4ea;
        color: #28a745;
        font-size: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
    }

    .confirmation-title {
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 0.25rem;
    }

    .confirmation-subtitle {
        color: #8a8fa3;
        margin-bottom: 2rem;
    }

    .order-summary {
        border: 1px solid #edf0f5;
        border-radius: 14px;
        padding: 1.5rem;
        text-align: left;
    }

    .confirmation-item-row {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        border-bottom: 1px solid #edf0f5;
    }

        .confirmation-item-row:last-child {
            border-bottom: none;
        }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
        color: #4a4f5e;
    }

        .summary-row.discount-row {
            color: #1e8e3e;
        }

    .summary-total {
        display: flex;
        justify-content: space-between;
        font-weight: 700;
        font-size: 1.1rem;
        color: #1a1a2e;
        padding-top: 0.75rem;
        margin-top: 0.75rem;
        border-top: 1px solid #edf0f5;
    }

    .meta-row {
        display: flex;
        justify-content: space-between;
        color: #4a4f5e;
        margin-bottom: 0.5rem;
    }

    .btn-continue {
        border-radius: 999px;
        padding: 0.6rem 2rem;
        font-weight: 600;
        margin-top: 1.5rem;
    }
</style>

<div class="confirmation-wrapper">
    <div class="confirmation-icon">&#10003;</div>
    <h2 class="confirmation-title">Order Placed!</h2>
    <p class="confirmation-subtitle">Thanks for your order — here's your receipt.</p>

    <div class="order-summary">
        <div class="meta-row">
            <span>Order No.</span>
            <span>#@Model.OrderId</span>
        </div>
        <div class="meta-row">
            <span>Date</span>
            <span>@Model.OrderDateTime?.ToString("dd MMM yyyy, h:mm tt")</span>
        </div>
        <div class="meta-row">
            <span>Payment Method</span>
            <span>@Model.PaymentMethod</span>
        </div>
        <div class="meta-row">
            <span>Payment Status</span>
            <span>@Model.PaymentStatus</span>
        </div>
        @if (!string.IsNullOrEmpty(Model.VoucherCode))
        {
            <div class="meta-row">
                <span>Voucher Applied</span>
                <span>@Model.VoucherCode</span>
            </div>
        }

        <hr />

        @foreach (var item in Model.Items)
        {
            <div class="confirmation-item-row">
                <span>@item.ProductName &times; @item.Quantity</span>
                <span>RM @item.LineTotal.ToString("0.00")</span>
            </div>
        }

        <hr />

        <div class="summary-row">
            <span>Subtotal</span>
            <span>RM @Model.Subtotal.ToString("0.00")</span>
        </div>
        <div class="summary-row">
            <span>SST (6%)</span>
            <span>RM @Model.SST.ToString("0.00")</span>
        </div>
        @if (Model.DiscountAmount > 0)
        {
            <div class="summary-row discount-row">
                <span>Voucher Discount</span>
                <span>-RM @Model.DiscountAmount.ToString("0.00")</span>
            </div>
        }
        <div class="summary-total">
            <span>Total</span>
            <span>RM @Model.Total.ToString("0.00")</span>
        </div>
    </div>

    <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-continue">Continue Shopping</a>
</div>
