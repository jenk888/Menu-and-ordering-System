<!-- Shared crop/rotate/flip modal. Include once per page via
     @await Html.PartialAsync("_PhotoEditorModal"), then call initPhotoEditor(...)
     from photo-editor.js against your own file input/button/preview-list ids. -->
<div id="editPhotoModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.6); z-index:1050;">
    <div style="background:#fff; max-width:520px; margin:6% auto; padding:1rem; border-radius:8px;">
        <h6 class="mb-2">Edit Photo</h6>

        <div style="max-height:400px; overflow:hidden; background:#222;">
            <img id="cropperImage" style="max-width:100%; display:block;" />
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="button" class="btn btn-sm btn-outline-secondary" id="rotateLeftBtn">&#8634; Rotate Left</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="rotateRightBtn">&#8635; Rotate Right</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="flipHBtn">&#8646; Flip Horizontal</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="flipVBtn">&#8645; Flip Vertical</button>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" class="btn btn-sm btn-secondary" id="cancelEditBtn">Cancel</button>
            <button type="button" class="btn btn-sm btn-primary" id="applyEditBtn">Apply</button>
        </div>
    </div>
</div>