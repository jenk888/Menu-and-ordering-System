<!-- Shared webcam capture modal. Include once per page, then call initPhotoEditor(...)
     from photo-editor.js with a webcamButtonId to wire it up. -->
<div id="webcamModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.6); z-index:1050;">
    <div style="background:#fff; max-width:520px; margin:6% auto; padding:1rem; border-radius:8px;">
        <h6 class="mb-2">Take Photo</h6>


        <div style="max-height:400px; overflow:hidden; background:#222; display:flex; justify-content:center; align-items:center;">
            <video id="webcamVideo" autoplay playsinline style="max-width:100%; max-height:400px; display:block;"></video>
            <canvas id="webcamCanvas" style="max-width:100%; max-height:400px; display:none;"></canvas>
        </div>

        <div id="webcamError" class="text-danger small mt-2" style="display:none;"></div>

        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" class="btn btn-sm btn-secondary" id="cancelWebcamBtn">Cancel</button>
            <button type="button" class="btn btn-sm btn-primary" id="capturePhotoBtn">Capture</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="retakePhotoBtn" style="display:none">Retake</button>
            <button type="button" class="btn btn-sm btn-primary" id="usePhotoBtn" style="display:none">Use Photo</button>
        </div>
    </div>
</div>
