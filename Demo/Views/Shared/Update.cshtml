<style>
    .pc-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1050;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }


        .pc-backdrop.open {
            display: flex;
        }

    .pc-modal {
        background: #fff;
        border-radius: 12px;
        width: 100%;
        max-width: 480px;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,0.2);
    }

    .pc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        border-bottom: 1px solid #eee;
    }

    .pc-title {
        font-size: 1.15rem;
        font-weight: 700;
        margin: 0;
    }

    .pc-close {
        border: none;
        background: transparent;
        font-size: 1.4rem;
        line-height: 1;
        cursor: pointer;
        color: #888;
    }

    .pc-body {
        padding: 16px 20px;
        overflow-y: auto;
    }

    .pc-loading {
        text-align: center;
        color: #888;
        padding: 24px 0;
    }

    .pc-group {
        margin-bottom: 18px;
    }

    .pc-group-title {
        display: flex;
        align-items: baseline;
        gap: 6px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .pc-required-badge {
        font-size: 0.72rem;
        font-weight: 600;
        color: #d9534f;
        border: 1px solid #d9534f;
        border-radius: 10px;
        padding: 1px 8px;
    }

    .pc-option {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #f2f2f2;
        cursor: pointer;
    }

        .pc-option:last-child {
            border-bottom: none;
        }

    .pc-option-label {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .pc-option-extra {
        color: #666;
        font-size: 0.9rem;
    }

    .pc-footer {
        padding: 14px 20px;
        border-top: 1px solid #eee;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .pc-qty {
        display: flex;
        align-items: center;
        border: 1px solid #ccc;
        border-radius: 8px;
        overflow: hidden;
        flex-shrink: 0;
    }

    .pc-qty-btn {
        border: none;
        background: #f6f6f6;
        width: 34px;
        height: 34px;
        font-size: 1.1rem;
        cursor: pointer;
    }

        .pc-qty-btn:disabled {
            color: #ccc;
            cursor: not-allowed;
        }

    .pc-qty-value {
        width: 34px;
        text-align: center;
        font-weight: 600;
    }

    .pc-confirm-btn {
        flex: 1;
        border: none;
        border-radius: 8px;
        background: #007bff;
        color: #fff;
        font-weight: 700;
        padding: 10px 12px;
        cursor: pointer;
    }

        .pc-confirm-btn:disabled {
            background: #cbd5e0;
            cursor: not-allowed;
        }

    .pc-error {
        color: #d9534f;
        font-size: 0.85rem;
        margin-top: 8px;
        display: none;
    }
</style>

<div class="pc-backdrop" id="pcBackdrop">
    <div class="pc-modal" role="dialog" aria-modal="true">
        <div class="pc-header">
            <h5 class="pc-title" id="pcTitle">&nbsp;</h5>
            <button type="button" class="pc-close" id="pcClose" aria-label="Close">&times;</button>
        </div>
        <div class="pc-body" id="pcBody">
            <div class="pc-loading" id="pcLoading">Loading...</div>
            <div id="pcGroups"></div>
            <div class="pc-error" id="pcError"></div>
        </div>
        <div class="pc-footer">
            <div class="pc-qty" id="pcQty">
                <button type="button" class="pc-qty-btn" id="pcQtyMinus">&minus;</button>
                <span class="pc-qty-value" id="pcQtyValue">1</span>
                <button type="button" class="pc-qty-btn" id="pcQtyPlus">+</button>
            </div>
            <button type="button" class="pc-confirm-btn" id="pcConfirm" disabled>Confirm</button>
        </div>
    </div>
</div>

<script src="~/js/productCustomize.js"></script>
