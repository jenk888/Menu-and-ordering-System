<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="shortcut icon" href="/photos/icon/logo.png">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap">
    <link rel="stylesheet" href="/css/pager.css">
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @RenderSection("head", false)
</head>
<body>
    @if (TempData["Info"] != null)
    {
        <div class="info" id="infoToast">@Html.Raw(TempData["Info"])</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="error" id="errorToast">@Html.Raw(TempData["Error"])</div>
    }

    <header>
        <button id="navToggle" type="button" aria-label="Toggle menu" style="background:none;border:none;font-size:24px;cursor:pointer;color:inherit;">&#9776;</button>
        <h1><a href="/">Menu and Ordering System</a></h1>
    </header>

    <div class="nav-backdrop" id="navBackdrop"></div>

    <nav id="sideNav">
        @* Guest links *@
        <a href="/Product/Index">Menu</a>
        <a href="/Cart/Index">Cart</a>

        @* Admin-only links *@
        @if (User.IsInRole("Admin"))
        {
            <a href="/Product/Manage">Products</a>
            <a href="/Category/Index">Categories</a>
            <a href="/ModifierGroup/Index">Modifier Groups</a>
            <a href="/Order/Manage">Orders</a>
            <a href="/Admin/Index">Members</a>
            <a href="/Admin/AdminList">Admins</a>
            <a href="/VoucherRules/Index">Vouchers</a>
        }
        @if (User.IsInRole("Member"))
        {
            <a href="/Order/History">My Orders</a>
            <a href="/Voucher/Index">Vouchers</a>
        }

                <div></div>
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <div class="border-top pt-3 mt-2">
                <a href="@(User.IsInRole("Admin") ? Url.Action("Profile", "Admin") : Url.Action("Profile", "User"))"
                   class="text-decoration-none text-dark d-flex align-items-center gap-2 mb-4 p-2 rounded"
                   style="margin-bottom: 20px;"
                   onmouseover="this.style.background='#f0f0f0'"
                   onmouseout="this.style.background='transparent'">
                    <img src="@(string.IsNullOrEmpty(User.FindFirst("Photo")?.Value) ? "/photos/user/default-user.png" : User.FindFirst("Photo")?.Value)"
                         alt="Profile"
                         class="rounded-circle"
                         style="width: 40px; height: 40px; object-fit: cover; border: 1px solid #ddd;" />

                    <div class="d-flex flex-column text-start" style="font-size: 0.85rem; line-height: 1.3; overflow: hidden;">
                        <span class="fw-bold text-truncate">@User.Identity.Name</span>
                        <small class="text-muted">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
                    </div>
                </a>

                <form asp-controller="User" asp-action="Logout" method="post" class="m-0" style="text-align: center;">
                    <button type="submit" class="btn btn-outline-danger btn-sm" style="width: 90%;">Logout</button>
                </form>
            </div>
        }
        else
        {
            <a href="/User/Login" class="btn btn-outline-primary btn-sm">Login</a>
            <a href="/User/Register" class="btn btn-primary btn-sm">Register</a>
        }
    </nav>

    <main>
        <h3>@ViewBag.Title</h3>
        @RenderBody()
    </main>

    <footer>
        Developed by <b>Yellow Palace</b> &middot;
        Copyrighted &copy; @DateTime.Today.Year
    </footer>

    <script src="/js/jquery.min.js"></script>
    <script src="/js/jquery.unobtrusive-ajax.min.js"></script>
    <script src="/js/jquery.validate.min.js"></script>
    <script src="/js/jquery.validate.unobtrusive.min.js"></script>
    <script src="/js/app.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function syncHeaderHeight() {
                var h = document.querySelector("header").offsetHeight;
                document.documentElement.style.setProperty("--header-h", h + "px");
        }
        const infoToast = document.getElementById("infoToast");
            if (infoToast) {
            setTimeout(() => {
            infoToast.style.opacity = "0";
            setTimeout(() => infoToast.remove(), 400);
            }, 3000);
        }

        const errorToast = document.getElementById("errorToast");
            if (errorToast) {
            setTimeout(() => {
            errorToast.style.opacity = "0";
            setTimeout(() => errorToast.remove(), 400);
            }, 3000);
        }

        syncHeaderHeight();
        window.addEventListener("resize", syncHeaderHeight);

        document.getElementById("navToggle").addEventListener("click", function (){
            document.body.classList.toggle("nav-open");
        });


        document.getElementById("navBackdrop").addEventListener("click", function() {
            document.body.classList.remove("nav-open");
        });
    </script>
  @await RenderSectionAsync("Scripts", required: false)  
  @RenderSection("foot", false)
</body>
</html>
 