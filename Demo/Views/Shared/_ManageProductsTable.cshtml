@model List<Product>

<form id="batchDeleteForm" asp-action="BatchDelete" method="post"
      onsubmit="return confirm('Delete all selected products?');"></form>

<table class="table table-bordered table-hover">
    <thead class="table-light">
        <tr>
            <th style="width: 30px">
                <input type="checkbox" onclick="document.querySelectorAll('.rowCheck').forEach(c => c.checked = this.checked)" />
            </th>
            <th>Photo</th>
            <th>Id</th>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Status</th>
            <th style="width: 160px">Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var p in Model)
        {
            var photoUrl = p.Photos.Select(ph => ph.PhotoUrl).FirstOrDefault();
            <tr>
                <td><input type="checkbox" class="rowCheck" name="ids" value="@p.Id" form="batchDeleteForm" /></td>
                <td>
                    <img src="@(photoUrl != null ? "/photos/product/" + photoUrl : "/photos/no-image.jpg")" style="width:60px; height:60px; object-fit:cover;" />
                    @if (p.Photos.Count > 1)
                    {
                        <span class="badge bg-secondary" style="position:absolute; bottom:2px; left:2px;">+@(p.Photos.Count - 1)</span>
                    }
                </td>
                <td>@p.Id</td>
                <td>@p.Name</td>
                <td>@p.Category?.Name</td>
                <td>RM@(p.Price.ToString("0.00"))</td>
                <td>@p.Stock</td>
                <td>
                    @if (p.IsAvailable)
                    {
                        <span class="badge bg-success">Available</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Out of Stock</span>
                    }
                </td>
                <td>
                    <a asp-action="ViewDetails" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                    <form asp-action="ToggleAvailability" asp-route-id="@p.Id" method="post" style="display: inline">
                        @if (p.IsAvailable)
                        {
                            <button type="submit" class="btn btn-sm btn-outline-warning"><i class="bi bi-x-circle"></i></button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-outline-warning"><i class="bi bi-check-circle"></i></button>
                        }
                    </form>
                    <a asp-action="Update" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" style="display: inline" onsubmit="return confirm('Delete this product?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    int page = (int)ViewBag.Page;
    int totalPages = (int)ViewBag.TotalPages;
}

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination">
            <li class="page-item @(page == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Manage" asp-route-page="@(page - 1)" asp-route-search="@ViewBag.Search" asp-route-categoryId="@ViewBag.CategoryId"
                   data-ajax="true" data-ajax-mode="replace" data-ajax-update="#manageTableTarget">Previous</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(page == i ? "active" : "")">
                    <a class="page-link" asp-action="Manage" asp-route-page="@i" asp-route-search="@ViewBag.Search" asp-route-categoryId="@ViewBag.CategoryId"
                       data-ajax="true" data-ajax-mode="replace" data-ajax-update="#manageTableTarget">@i</a>
                </li>
            }
            <li class="page-item @(page >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Manage" asp-route-page="@(page + 1)" asp-route-search="@ViewBag.Search" asp-route-categoryId="@ViewBag.CategoryId"
                   data-ajax="true" data-ajax-mode="replace" data-ajax-update="#manageTableTarget">Next</a>
            </li>
        </ul>
    </nav>
}
