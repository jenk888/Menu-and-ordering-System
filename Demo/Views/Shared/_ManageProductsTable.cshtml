@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<Product>

@{
    // display label and sort key for each column
    (string Label, string Key)[] fields =
    [
        ("Id", "id"),
        ("Name", "name"),
        ("Category", "category"),
        ("Price", "price"),
        ("Stock", "stock"),
        ("Status", "status"),
    ];
}

<!-- Hidden fields to preserve sort and direction in the form -->
@Html.Hidden("sort", "", new { form = "f" })
@Html.Hidden("dir", "", new { form = "f" })


<form id="batchDeleteForm" asp-action="BatchDelete" method="post"
      onsubmit="return confirm('Delete all selected products?');"></form>

<p class="text-muted">
    @Model.Count() of @Model.TotalItemCount product(s) |
    Page @Model.PageNumber of @Model.PageCount
</p>

<table class="table table-bordered table-hover">
    <thead class="table-light">
        <tr>
            <th style="width: 30px">
                <input type="checkbox" onclick="document.querySelectorAll('.rowCheck').forEach(c => c.checked = this.checked)" />
            </th>
            <th>Photo</th>
            @foreach (var f in fields)
            {
                string d = "asc";
                string c = "";

                if (f.Key == ViewBag.Sort)
                {
                    d = ViewBag.Dir == "desc" ? "asc" : "desc";
                    c = ViewBag.Dir;
                }

                <th>
                    <a data-ajax="true"
                       data-ajax-update="#target"
                       data-ajax-loading="#loader"
                       href="?search=@ViewBag.Search&categoryId=@ViewBag.CategoryId&sort=@f.Key&dir=@d" class="@c">@f.Label</a>
                </th>
            }
            <th style="width: 160px">Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var p in Model)
        {
            var photoUrl = p.Photos.Select(ph => ph.PhotoUrl).FirstOrDefault();
            <tr>
                <td><input type="checkbox" class="rowCheck" name="ids" value="@p.Id" form="batchDeleteForm" /></td>
                <td style="position: relative;">
                    <img src="@(photoUrl != null ? "/photos/product/" + photoUrl : "/photos/no-image.jpg")" style="width:60px; height:60px; object-fit:cover;" />
                    @if (p.Photos.Count > 1)
                    {
                        <span class="badge bg-secondary" style="position:absolute; bottom:2px; left:2px;">+@(p.Photos.Count - 1)</span>
                    }
                </td>
                <td>@p.Id</td>
                <td>@p.Name</td>
                <td>@p.Category?.Name</td>
                <td>RM@(p.Price.ToString("0.00"))</td>
                <td>@p.Stock</td>
                <td>
                    @if (p.IsAvailable)
                    {
                        <span class="badge bg-success">Available</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Hidden</span>
                    }
                </td>
                <td>
                    <a asp-action="ViewDetails" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye-fill"></i></a>
                    <form asp-action="ToggleAvailability" asp-route-id="@p.Id" method="post" style="display: inline">
                        @if (p.IsAvailable)
                        {
                            <button type="submit" class="btn btn-sm btn-outline-warning"><i class="bi bi-x-circle-fill"></i></button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-outline-warning"><i class="bi bi-check-circle-fill"></i></button>
                        }
                    </form>
                    <a asp-action="Update" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil-fill"></i></a>
                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" style="display: inline" onsubmit="return confirm('Delete this product?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash-fill"></i></button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@* Pager*@
@{
    var options = PagedListRenderOptions.ClassicPlusFirstAndLast;
    options.LinkToFirstPageFormat = "First";
    options.LinkToLastPageFormat = "Last";
    options.LinkToPreviousPageFormat = "Previous";
    options.LinkToNextPageFormat = "Next";

    var ajaxOptions = new AjaxOptions
    {
        HttpMethod = "get",
        UpdateTargetId = "target",
        LoadingElementId = "#loader",
    };
}

@Html.PagedListPager(
    Model,
    p => Url.Action("Manage", new { page = p, search = ViewBag.Search, categoryId = ViewBag.CategoryId, sort = ViewBag.Sort, dir = ViewBag.Dir }),
    PagedListRenderOptions.EnableUnobtrusiveAjaxReplacing(options, ajaxOptions))

